<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  The MSIX package for the Microsoft Store. A template: the words in @...@
  are filled in by tools/package/msix.py, three of them from the identity
  Partner Center gives the app when its name is reserved. See
  docs/PACKAGING.md, "The Microsoft Store".

  Both programs are in it, and both are on PATH through an execution alias,
  which is how a packaged application puts a command on PATH: typing
  `veilvoice` in a new terminal runs the packaged veilvoice.exe. Only the
  window appears in the Start menu.

  Capabilities, and why each one:
    runFullTrust  VeilVoice is an ordinary desktop program, not a sandboxed
                  app. The Store asks for a sentence saying why; it is in the
                  submission notes.
    microphone    Live mode records from the microphone. Declaring it puts
                  VeilVoice in Windows' microphone privacy list, where it can
                  be switched off.
  Nothing asks for the network, the camera, contacts, location or anything
  else, because nothing in VeilVoice uses them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="@IDENTITY_NAME@"
            Publisher="@PUBLISHER@"
            Version="@VERSION@.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VeilVoice</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Removes the biometric voiceprint from a recording and keeps the words, fully offline.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 is the oldest release that runs packaged desktop programs with execution aliases. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-gb" />
  </Resources>

  <Applications>
    <Application Id="VeilVoice" Executable="veilvoice-gui.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VeilVoice"
                          Description="Remove the voiceprint from a recording, keep the words"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\SmallTile.png"
                         Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="veilvoice-gui.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="veilvoice-gui.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>

    <!-- The command line: on PATH, and kept out of the Start menu. -->
    <Application Id="VeilVoiceCli" Executable="veilvoice.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VeilVoice command line"
                          Description="The veilvoice command"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="veilvoice.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="veilvoice.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
